<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Folder Not Found</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body class="bg-gray-100 min-h-screen">
    <div class="flex h-screen">
        <!-- Sidebar -->
        <div class="w-64 bg-white shadow-md">
            <div class="p-4">
                <h2 class="text-lg font-semibold text-gray-700 mb-4">Allowed Folders</h2>
                <ul class="space-y-2">
                    <% config.fileManager.allowedFolders.forEach(folder => { %>
                        <li>
                            <a href="/?path=<%= encodeURIComponent(folder.path) %>" class="flex items-center p-2 text-gray-600 rounded hover:bg-gray-100">
                                <i class="fas fa-folder text-yellow-500 mr-2"></i>
                                <%= folder.name %>
                            </a>
                        </li>
                        <% }); %>
                </ul>
            </div>
        </div>

        <!-- Main Content -->
        <div class="flex-1 overflow-auto">
            <div class="flex flex-col items-center justify-center h-full">
                <div class="text-center">
                    <div class="text-6xl text-red-500 mb-4">
                        <i class="fas fa-folder-open"></i>
                    </div>
                    <h1 class="text-4xl font-bold text-gray-800 mb-4">404</h1>
                    <h2 class="text-2xl text-gray-600 mb-8">Folder Not Found</h2>
                    <p class="text-gray-500 mb-8">
                        The folder you're looking for doesn't exist:<br>
                        <span class="font-mono bg-gray-100 px-2 py-1 rounded mt-2 inline-block text-sm">
                            <%= path %>
                        </span>
                    </p>
                    <a href="/" class="bg-blue-500 text-white px-6 py-3 rounded-lg hover:bg-blue-600 transition-colors inline-flex items-center">
                        <i class="fas fa-home mr-2"></i> Go Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</body>

</html>