{
    "name": "filevault",
    "version": "1.0.0",
    "description": "A modern, secure, and user-friendly file management system built with Express and TypeScript",
    "main": "src/server.ts",
    "license": "MIT",
    "author": {
        "name": "Your Name"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/yourusername/filevault.git"
    },
    "keywords": [
        "file-manager",
        "express",
        "typescript",
        "file-upload",
        "file-preview",
        "web-interface"
    ],
    "scripts": {
        "start": "ts-node src/server.ts",
        "dev": "nodemon --exec ts-node src/server.ts",
        "build": "tsc",
        "lint": "eslint . --ext .ts",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "dependencies": {
        "@types/bytes": "^3.1.5",
        "@types/js-yaml": "^4.0.9",
        "bytes": "^3.1.2",
        "ejs": "^3.1.10",
        "express": "^4.21.2",
        "js-yaml": "^4.1.0",
        "multer": "^1.4.5-lts.1"
    },
    "devDependencies": {
        "@types/express": "^5.0.0",
        "@types/multer": "^1.4.12",
        "@types/node": "^22.10.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.7.3"
    }
}